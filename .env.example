# Server
PORT=3000
NODE_ENV=development

# SQLite database path (relative to project root or absolute)
DATABASE_PATH=./data/wise.db

# LLM provider: mock | openai | gemini | openrouter
# mock = no API key needed (deterministic routing + hash embeddings)
LLM_PROVIDER=mock

# OpenAI-compatible API base (default OpenAI; set for OpenRouter / proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (when LLM_PROVIDER=openrouter)
# Uses OpenAI-compatible client with OPENAI_BASE_URL defaulting to OpenRouter.
# Prefer OPENROUTER_API_KEY; OPENAI_API_KEY is accepted as fallback.
# Default chat model is openai/gpt-oss-120b (chat-only).
# Embeddings stay mock unless EMBED_PROVIDER overrides (see below).
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# Optional OpenRouter attribution headers:
# OPENROUTER_HTTP_REFERER=https://github.com/jaewonkyoung-alt/wise-faq-bot
# OPENROUTER_X_TITLE=WISE FAQ Bot

# Embeddings provider override: mock | openai | gemini
# When unset: follows LLM_PROVIDER, except openrouter → mock (gpt-oss-120b is chat-only)
# EMBED_PROVIDER=mock

# Gemini (when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Semantic search: minimum cosine similarity to accept a hit
SEMANTIC_MIN_SCORE=0.35

# Optional: restrict Kakao skill endpoint (leave empty to allow all in MVP)
# KAKAO_SKILL_SECRET=

# Admin API gate — REQUIRED.
# All /api/admin/* routes return 401 admin_token_not_configured when this is empty.
# Send it from the admin UI or as header: x-admin-token: <value>
ADMIN_TOKEN=change-me-local-admin-token

# Public base URL for Kakao PDF webLink buttons (no trailing slash)
# Example: https://your-host.example.com
# PUBLIC_BASE_URL=
