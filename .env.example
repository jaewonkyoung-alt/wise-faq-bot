# Server
PORT=3000
NODE_ENV=development

# SQLite database path (relative to project root or absolute)
DATABASE_PATH=./data/wise.db

# LLM provider: mock | openai | gemini | openrouter
# mock = no API key needed (deterministic routing + hash embeddings)
LLM_PROVIDER=mock

# OpenAI-compatible API base (default OpenAI; set for OpenRouter / proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (when LLM_PROVIDER=openrouter)
# Prefer OPENROUTER_API_KEY; OPENAI_API_KEY is accepted as fallback.
# Embeddings stay mock unless EMBED_PROVIDER overrides.
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENROUTER_HTTP_REFERER=https://github.com/jaewonkyoung-alt/wise-faq-bot
# OPENROUTER_X_TITLE=WISE FAQ Bot

# Embeddings provider override: mock | openai | gemini
# EMBED_PROVIDER=mock

# Gemini (when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Semantic search: minimum cosine similarity to accept a hit
SEMANTIC_MIN_SCORE=0.35

# Kakao Skill endpoint protection
# Header: x-kakao-skill-secret: <same value>
# If unset, POST /api/kakao/skill stays open (MVP). Set a strong secret in production.
# KAKAO_SKILL_SECRET=

# Admin API gate — REQUIRED for /api/admin/* and /api/unanswered
# Empty -> 401 admin_token_not_configured (fail-closed)
# Send from admin UI or header: x-admin-token: <value>
ADMIN_TOKEN=change-me-local-admin-token

# Public HTTPS base URL for Kakao PDF webLink buttons (no trailing slash)
# Local tunnels (ngrok, cloudflared, etc.) work: https://xxxx.example.com
# Without this, students see a short message that PDF link is not configured
# PUBLIC_BASE_URL=
