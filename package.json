{
  "name": "wise-faq-bot",
  "version": "0.2.0",
  "description": "Dongguk University WISE Phase-1: graduation requirements (primary) + clubs hybrid RAG",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "reindex": "tsx scripts/reindex.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:clubs": "tsx scripts/eval-clubs.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:graduation": "tsx scripts/test-graduation.ts",
    "test:kakao-grad": "tsx scripts/test-kakao-grad.ts",
    "test:room-code": "tsx scripts/test-room-code.ts",
    "test:campus-map": "tsx scripts/test-campus-map.ts",
    "test:club-list": "tsx scripts/test-club-list.ts",
    "test:notices": "tsx scripts/test-notices.ts",
    "test:notice-sub": "tsx scripts/test-notice-subscription.ts",
    "test:grad-criteria": "tsx scripts/test-grad-criteria.ts",
    "test:grad-import": "tsx scripts/test-grad-import.ts",
    "import:graduation": "tsx scripts/import-graduation.ts",
    "test:club-answers": "tsx scripts/test-club-answers.ts",
    "clubs:apply-updates": "tsx scripts/apply-club-updates.ts",
    "test:unanswered": "tsx scripts/test-unanswered.ts",
    "test:notice-trash": "tsx scripts/test-notice-trash.ts",
    "test:club-import": "tsx scripts/test-club-import.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
